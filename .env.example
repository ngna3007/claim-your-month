# Leave unset for local dev (falls back to file:./dev.db).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Public URL the QR encodes (your Vercel domain in production).
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional. Join CTA stays hidden until JOIN_URL is set.
# NEXT_PUBLIC_JOIN_URL=https://example.com/join
# NEXT_PUBLIC_JOIN_LABEL=Come join us
# Override merch copy, or set empty to hide it.
# NEXT_PUBLIC_MERCH=Show this screen to a CodeCatalyst member to grab your free gift.
